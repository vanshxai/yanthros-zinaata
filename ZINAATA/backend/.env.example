# Copy to .env for local testing (never commit the real .env).
# Railway: set these as project environment variables instead of a file.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service_role key (Project Settings -> API -> service_role).
# Elevated privilege, server-side only -- never put this in the Android app.
SUPABASE_SERVICE_KEY=

# Local dev only; Railway sets PORT itself.
PORT=8080
